# Variables de entorno de la API de inventario.
# Copia este archivo a `.env.local` (npm run start / start:dev / start:debug)
# o a `.env` (npm run start:prod) y reemplaza los placeholders.

# --- Aplicación ----------------------------------------------------------------
# `local` en .env.local, `dev` en .env.
NODE_ENV=<local|dev>
# HTTP. Las pruebas de contrato y el agente esperan el 8000.
PORT=<api-port>
# Orígenes de la UI con CORS (HTTP y WebSocket), separados por coma, sin ruta ni "/" final.
# local: opcional; localhost y las IP de la red local ya se permiten en cualquier puerto.
# dev: obligatorio; el dominio de CloudFront de la UI.
CORS_ORIGINS=<ui-origins>

# HTTPS en un segundo puerto, para el celular (la cámara solo abre en una página segura).
# local: `npm run cert:local -- <ip-de-la-laptop>` crea certs/local-key.pem y certs/local-cert.pem.
# dev: vacías si el TLS lo termina el balanceador (ALB) o CloudFront delante de ECS.
HTTPS_PORT=<https-port>
HTTPS_KEY_PATH=<https-key-path>
HTTPS_CERT_PATH=<https-cert-path>

# --- Base de datos (PostgreSQL) -------------------------------------------------
# El esquema lo crea Liquibase en hack-saltillo-db; la API no lo modifica.
DATABASE_HOST=<db-host>
DATABASE_PORT=<db-port>
DATABASE_NAME=<db-name>
DATABASE_USER=<db-user>
DATABASE_PASSWORD=<db-password>
# `true` contra RDS.
DATABASE_SSL=<true|false>
# CA bundle file path required when DATABASE_SSL=true.
DATABASE_SSL_CA_PATH=<rds-ca-bundle-path>

# --- AWS / SQS -----------------------------------------------------------------
AWS_REGION=<aws-region>
# Solo para correr fuera de AWS. En ECS se dejan vacías: se usa el rol de la tarea.
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# Solo con un emulador local (ElasticMQ: http://localhost:9324). En AWS, vacía.
SQS_ENDPOINT_URL=<sqs-endpoint-url>

# Colas de entrada (FIFO). El simulador manda aquí los eventos.
SQS_SHOP_CATALOG_URL=<sqs-queue-url>
SQS_SHOP_WORK_ORDERS_URL=<sqs-queue-url>
SQS_SHOP_INSPECTIONS_URL=<sqs-queue-url>
SQS_SHOP_PURCHASING_URL=<sqs-queue-url>
# Eventos que genera el mensaje del usuario al agente (inventory-broker-notifications.fifo).
SQS_NOTIFICATIONS_URL=<sqs-queue-url>

# Colas de salida (FIFO).
SQS_INVENTORY_EVENTS_URL=<sqs-queue-url>
SQS_INVENTORY_DLQ_URL=<sqs-queue-url>

# --- Agente --------------------------------------------------------------------
# La API le reenvía aquí (POST, con el sobre) cada evento de la cola de notificaciones. Vacía = no reenvía.
AGENT_URL=<agent-url>
# Lambda del agente (hack-saltillo-events-agent). Si está, la API la invoca con su rol (IAM) para
# `POST /chat` y para las notificaciones, en lugar de AGENT_URL. Vacía = sin Lambda.
AGENT_FUNCTION_NAME=<agent-lambda-name>

# --- Pipeline de eventos (opcionales; valores por defecto) ---------------------------
# Minutos que un evento puede esperar una dependencia antes de ir a la DLQ.
# INGEST_MAX_WAIT_MINUTES=60
# Intentos de un evento que falla por un error (no por una dependencia) antes de la DLQ.
# INGEST_MAX_ATTEMPTS=5
# Cada cuánto se reintentan los pendientes y se publica outbox_event.
# INGEST_RETRY_INTERVAL_MS=5000
# OUTBOX_PUBLISH_INTERVAL_MS=250
